 		epsilon);
+
+	const char *g2aOutputPath = getenv("MISTIC_G2A_OUTPUT");
+	if (g2aOutputPath == nullptr) {
+		std::cerr << "MISTIC_G2A_OUTPUT is required for the G2A adapter" << std::endl;
+		return 3;
+	}
+	std::vector<unsigned long long> g2aPairs;
+	std::vector<unsigned char> g2aHasSelf(numPoints, 0);
+	unsigned long long g2aRawKernelPairs = 0;
+	unsigned long long g2aInvalidPositions = 0;
+	for (unsigned int orderedQuery = 0; orderedQuery < numPoints; orderedQuery++) {
+		const unsigned int query = pointArray[orderedQuery];
+		if (query >= numPoints) {
+			g2aInvalidPositions++;
+			continue;
+		}
+		for (unsigned int arrayIndex = 1;
+			 arrayIndex < table[orderedQuery].cntNDataArrays; arrayIndex++) {
+			for (unsigned int valueIndex = table[orderedQuery].vectindexmin[arrayIndex];
+				 valueIndex <= table[orderedQuery].vectindexmax[arrayIndex]; valueIndex++) {
+				const unsigned int orderedCandidate =
+					table[orderedQuery].vectdataPtr[arrayIndex][valueIndex];
+				g2aRawKernelPairs++;
+				if (orderedCandidate >= numPoints) {
+					g2aInvalidPositions++;
+					continue;
+				}
+				const unsigned int candidate = pointArray[orderedCandidate];
+				if (candidate >= numPoints) {
+					g2aInvalidPositions++;
+					continue;
+				}
+				if (query == candidate) g2aHasSelf[query] = 1;
+				g2aPairs.push_back(
+					static_cast<unsigned long long>(query) * numPoints + candidate);
+			}
+		}
+	}
+	unsigned long long g2aSelfInsertions = 0;
+	for (unsigned int point = 0; point < numPoints; point++) {
+		if (!g2aHasSelf[point]) {
+			g2aPairs.push_back(static_cast<unsigned long long>(point) * numPoints + point);
+			g2aSelfInsertions++;
+		}
+	}
+	std::sort(g2aPairs.begin(), g2aPairs.end());
+	std::ofstream g2aOutput(g2aOutputPath, std::ios::binary | std::ios::out);
+	g2aOutput.write(reinterpret_cast<const char *>(g2aPairs.data()),
+		static_cast<std::streamsize>(g2aPairs.size() * sizeof(unsigned long long)));
+	g2aOutput.close();
+	if (!g2aOutput) {
+		std::cerr << "Failed to write G2A canonical pair file" << std::endl;
+		return 4;
+	}
+	std::cout << "G2A_ADAPTER raw_kernel_pairs=" << g2aRawKernelPairs
+		<< " normalized_self_insertions=" << g2aSelfInsertions
+		<< " invalid_positions=" << g2aInvalidPositions
+		<< " output_pairs=" << g2aPairs.size() << std::endl;
