+// Export flags produced by upstream dataProcessRnn without recomputing or
+// changing a distance or radius decision.
+__global__ void compactAcceptedPairs(TN *node_list, int *id_list, int *qid_list,
+									 int *p_list, int offset_p, int level_size,
+									 int lnum, int n, unsigned long long *pairs,
+									 unsigned int *pair_count)
+{
+	const unsigned long long tid =
+		static_cast<unsigned long long>(blockDim.x) * blockIdx.x + threadIdx.x;
+	const unsigned long long stride =
+		static_cast<unsigned long long>(blockDim.x) * gridDim.x;
+	const unsigned long long slots = static_cast<unsigned long long>(lnum) * MAX_SIZE;
+	const int map_span = level_size / (MAX_SIZE + 3);
+	const int flag_base = offset_p + map_span * 3;
+	for (unsigned long long slot = tid; slot < slots; slot += stride)
+	{
+		if (p_list[flag_base + slot] == 0)
+			continue;
+		const int bid = static_cast<int>(slot / MAX_SIZE);
+		const int did = static_cast<int>(slot % MAX_SIZE);
+		const int nid = p_list[offset_p + map_span + bid];
+		const int qid = p_list[offset_p + map_span * 2 + bid];
+		const int data_id = id_list[node_list[nid].lid + did];
+		const int query_id = qid_list[qid];
+		const unsigned int out = atomicAdd(pair_count, 1U);
+		pairs[out] = static_cast<unsigned long long>(query_id) *
+			static_cast<unsigned long long>(n) + static_cast<unsigned int>(data_id);
+	}
+}
